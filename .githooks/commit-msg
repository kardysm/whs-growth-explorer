#!/bin/sh
# Version bump per commit (semver): patch by default, "#minor"/"#major" in the message raise the level,
# "[skip version]" (or a merge commit) skips. git only guarantees the CURRENT message in commit-msg —
# a pre-commit hook reads a stale COMMIT_EDITMSG one commit behind (verified), hence this hook type.
# Activate once per clone:  git config core.hooksPath .githooks
set -e
cd "$(git rev-parse --show-toplevel)"
command -v node >/dev/null 2>&1 || { echo "[version] node not found - skipping bump"; exit 0; }
node scripts/bump_version.mjs "$1"
git add package.json
